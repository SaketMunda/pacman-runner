# Copy to backend/.env and fill in. backend/.env is gitignored.

# Required only when JEV_MODE=live.
OPENROUTER_API_KEY=sk-or-v1-...

# stub = deterministic local policy, no network, no key needed (default).
# live = call Jev through OpenRouter's Decisions API.
JEV_MODE=stub

# Jev is served from OpenRouter's *alpha Decisions* endpoint, not /v1/chat/completions.
OPENROUTER_BASE_URL=https://openrouter.ai/api/alpha
JEV_MODEL=~typesafe/jev-latest

# Hard ceiling on a Jev call. The frontend prefetches decisions a corridor ahead, so
# anything slower than this is useless by the time it lands -- we fall back instead.
JEV_TIMEOUT_SECONDS=1.5

# Append every decision to backend/logs/decisions.jsonl for inspection.
JEV_LOG_DECISIONS=true

# Origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
